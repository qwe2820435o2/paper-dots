# Required by `npm run sync:guides` — see docs/guide-pages.md § M7 for the one-time
# service-account setup (GCP project, Sheets API, sharing the sheet as Viewer).
# The private key is base64-encoded on purpose: a raw multi-line PEM is a recurring footgun
# in .env parsers. `base64 -w0 <key.json's private_key field>` produces the value below.

GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY_B64=
