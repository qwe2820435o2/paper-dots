# Required by `npm run sync:guides` — see docs/guide-pages.md § M7 for the one-time
# service-account setup (GCP project, Sheets API, sharing the sheet as Viewer).
# The private key is base64-encoded on purpose: a raw multi-line PEM is a recurring footgun
# in .env parsers. `base64 -w0 <key.json's private_key field>` produces the value below.

GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY_B64=

# Optional. Base URL of the headless WordPress REST API backing /blog, including the
# `/wp-json/wp/v2` suffix. Unset falls back to the production Railway instance, so local
# development needs this only when pointing at a different WordPress. `next.config.ts` derives
# the `next/image` remote-host allowlist from the same value.
WORDPRESS_API_URL=
